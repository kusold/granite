# granite-network-status — active connection details for the network
# panel, a port of Omarchy's `omarchy-network-status --verbose`
# (https://github.com/basecamp/omarchy, MIT). The panel's reactive half
# lives in Quickshell's NetworkManager service; this answers what only the
# routing table, /sys, and probes can: the default route's interface,
# address, gateway, transfer counters, the wifi or ethernet link details,
# and gateway/internet ping samples. Output is tab-separated key/value
# lines (parsed by NetworkModel.parseKeyValue); nothing is printed when
# there is no route.
#
# The tools arrive through the nixpkgs wrapper's PATH (see
# modules/home/hyprland.nix), so unlike Omarchy's copy there are no
# omarchy-cmd-present guards here.
probe=1.1.1.1

route_json=$(ip -j route get "$probe" 2>/dev/null)
[[ -z $route_json ]] && exit 0

iface=$(jq -r '.[0].dev // ""' <<<"$route_json" 2>/dev/null)
[[ -z $iface ]] && exit 0

gw=$(jq -r '.[0].gateway // ""' <<<"$route_json" 2>/dev/null)
src=$(jq -r '.[0].prefsrc // ""' <<<"$route_json" 2>/dev/null)
prefix=$(ip -j addr show "$iface" 2>/dev/null | jq -r '.[0].addr_info[]? | select(.family == "inet") | .prefixlen // ""' 2>/dev/null | head -n 1)

printf 'iface\t%s\n' "$iface"
printf 'ip\t%s\n' "$src"
printf 'prefix\t%s\n' "$prefix"
printf 'gateway\t%s\n' "$gw"

if [[ -r /sys/class/net/$iface/statistics/rx_bytes ]]; then
  printf 'rx_bytes\t%s\n' "$(cat /sys/class/net/$iface/statistics/rx_bytes)"
fi
if [[ -r /sys/class/net/$iface/statistics/tx_bytes ]]; then
  printf 'tx_bytes\t%s\n' "$(cat /sys/class/net/$iface/statistics/tx_bytes)"
fi

ping_latency_ms() {
  LC_ALL=C ping -n -c 1 -W 1 "$1" 2>/dev/null | awk -F'time[=<]' '/time[=<]/ { split($2, parts, " "); print parts[1]; exit }'
}

if [[ -d /sys/class/net/$iface/wireless ]]; then
  printf 'type\twifi\n'

  link=$(iw dev "$iface" link 2>/dev/null)

  if [[ -n $link ]]; then
    printf 'ssid\t%s\n' "$(awk '/SSID:/ { sub(/.*SSID: /, ""); print; exit }' <<<"$link")"
    printf 'signal_dbm\t%s\n' "$(awk '/signal:/ { print $2; exit }' <<<"$link")"
    printf 'freq\t%s\n' "$(awk '/freq:/ { print $2; exit }' <<<"$link")"
    printf 'bitrate\t%s\n' "$(awk '/tx bitrate:/ { print $3, $4; exit }' <<<"$link")"
  fi
else
  printf 'type\tethernet\n'
  [[ -r /sys/class/net/$iface/speed ]] && printf 'speed\t%s\n' "$(cat /sys/class/net/$iface/speed)"
  [[ -r /sys/class/net/$iface/duplex ]] && printf 'duplex\t%s\n' "$(cat /sys/class/net/$iface/duplex)"
fi

# One probe each per invocation; the panel averages a rolling window of
# samples (a lost probe prints an empty value and counts as loss).
if [[ -n $gw ]]; then
  printf 'router_ping_ms\t%s\n' "$(ping_latency_ms "$gw")"
fi
printf 'internet_ping_ms\t%s\n' "$(ping_latency_ms "$probe")"
