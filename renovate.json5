{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  enabledManagers: [
    'custom.regex',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'marksman release binaries in the nix overlay',
      managerFilePatterns: [
        '/modules/overlays/marksman\\.nix$/',
      ],
      matchStrings: [
        'url = "https://github\\.com/(?<packageName>[^/"]+/[^/"]+)/releases/download/(?<currentValue>[^/"]+)/(?<depName>[^/"]+)";\\s*hash = "sha256:(?<currentDigest>[0-9a-f]{64})";',
      ],
      datasourceTemplate: 'github-release-attachments',
      versioningTemplate: 'regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$',
    },
  ],
  packageRules: [
    {
      matchDatasources: [
        'github-release-attachments',
      ],
      groupName: 'marksman',
    },
  ],
}
